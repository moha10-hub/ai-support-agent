# --- API ordini (mock) ---
ORDERS_API_URL=http://127.0.0.1:8001
ORDERS_API_TIMEOUT_SECONDS=5

# --- LLM: gemini (gratis con chiave di Google AI Studio) oppure openai ---
LLM_PROVIDER=gemini
# Chiave : https://aistudio.google.com/apikey   (NON committare mai il file .env)
GOOGLE_API_KEY=
# Modello (vuoto = default del provider). Se dà errore di quota/modello non trovato, cambia modello:
# controlla quelli disponibili per il tuo account su https://aistudio.google.com/rate-limit
LLM_MODEL=
# OPENAI_API_KEY=